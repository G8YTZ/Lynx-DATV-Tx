From eade46c58ef9a9bed730a6ddbc32f054ac7a5996 Mon Sep 17 00:00:00 2001
From: Justin Cockett <justin.cockett@me.com>
Date: Sat, 14 Nov 2026 20:53:48 +0000
Subject: [PATCH] Programme selection for multi-programme streams

A 'programme' setting (service ID; 0 lets VLC choose, as before) passed
to VLC as :program=N, as Portsdown's channel setting does, and left and
right on the remote to step it while watching. A second programme in
the same stream (such as a 4K stills service) then never takes over.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 config.sample.yaml   |  5 +++++
 rydeplayer/player.py | 42 +++++++++++++++++++++++++++++++++++++++---
 2 files changed, 44 insertions(+), 3 deletions(-)

diff --git a/config.sample.yaml b/config.sample.yaml
index 5563053..f21841f 100644
--- a/config.sample.yaml
+++ b/config.sample.yaml
@@ -145,6 +145,11 @@ audio:
     volumeStep: 25
     enableMenu: False
 
+# Programme (service ID) to play when the stream carries more than one,
+# as Portsdown's channel setting; 0 lets VLC choose. Left and right on the
+# remote step it (0, 1, 2 ... 8).
+programme: 0
+
 debug:
     enableMenu: False
     autoplay: True
diff --git a/rydeplayer/player.py b/rydeplayer/player.py
index 9c38b37..9351796 100644
--- a/rydeplayer/player.py
+++ b/rydeplayer/player.py
@@ -341,6 +341,10 @@ class guiState(rydeplayer.states.gui.SuperStates):
                 self.player.switchPresetRelative(-1)
             elif(event == rydeplayer.common.navEvent.CHAND):
                 self.player.switchPresetRelative(1)
+            elif(event == rydeplayer.common.navEvent.LEFT):
+                self.player.stepProgramme(-1)
+            elif(event == rydeplayer.common.navEvent.RIGHT):
+                self.player.stepProgramme(1)
 
 
 # GUI state for when the menu isnt showing
@@ -393,6 +397,8 @@ class rydeConfig(object):
             'disableHardwareCodec': True,
             'useFTfont': False,
             })
+        # programme (service ID) in a multi-programme stream; 0 lets VLC choose
+        self.programme = 0
         self.configRev = 3
     #setter for default values
     def setAutoplay(self, newval):
@@ -562,6 +568,14 @@ class rydeConfig(object):
                             print("Invalid audio menu config, skipping")
                             perfectConfig = False
 
+            # programme to play when the stream carries more than one
+            if 'programme' in config:
+                if isinstance(config['programme'], int) and config['programme'] >= 0:
+                    self.programme = config['programme']
+                else:
+                    print("Invalid programme config, skipping")
+                    perfectConfig = False
+
             # parse debug options
             if 'debug' in config:
                 if isinstance(config['debug'], dict):
@@ -671,6 +685,7 @@ class player(object):
 
         # setup vlc
         self.recvVLCEvent, self.sendVLCEvent = socket.socketpair()
+        self.programme = self.config.programme
         self.vlcStartup()
         self.config.tuner.addCallbackFunction(self.vlcStopOnRetune)
 
@@ -877,13 +892,34 @@ class player(object):
     # retrigger vlc to play, mostly exsists as its needed as a callback
     def vlcPlay(self):
         newMediaFD = self.sourceMan.getMediaFd()
-        if newMediaFD != self.vlcMediaFD:
+        if newMediaFD != self.vlcMediaFD or self.vlcMediaProgramme != self.programme:
             self.vlcPlayer.stop()
             self.vlcMediaFD = newMediaFD
             del(self.vlcMedia)
-            self.vlcMedia = self.vlcInstance.media_new_fd(self.vlcMediaFD)
+            self.vlcMedia = self.vlcNewMedia()
         self.vlcPlayer.set_media(self.vlcMedia)
         self.vlcPlayer.play()
+
+    # the stream for VLC, limited to one programme when one is chosen
+    # (as Portsdown's --program N), so a second programme in the same
+    # stream (such as a 4K stills service) never takes over the picture
+    def vlcNewMedia(self):
+        media = self.vlcInstance.media_new_fd(self.vlcMediaFD)
+        if self.programme:
+            media.add_option(':program=' + str(self.programme))
+        self.vlcMediaProgramme = self.programme
+        return media
+
+    # step the programme: 0 (VLC chooses), 1, 2 ... PROGRAMME_MAX, round again
+    PROGRAMME_MAX = 8
+    def stepProgramme(self, step):
+        self.setProgramme((self.programme + step) % (self.PROGRAMME_MAX + 1))
+
+    def setProgramme(self, programme):
+        self.programme = programme
+        print("Programme: " + (str(programme) if programme else "automatic"))
+        if self.vlcPlayer.get_state() in [vlc.State.Playing, vlc.State.Opening]:
+            self.vlcPlay()
     def vlcStop(self):
         self.vlcPlayer.stop()
     def vlcAbort(self):
@@ -914,7 +950,7 @@ class player(object):
         vlcEvents = self.vlcPlayer.event_manager()
         vlcEvents.event_attach(vlc.EventType.MediaPlayerEndReached, self.vlcStopOnEndEvent)
         self.vlcMediaFD = self.sourceMan.getMediaFd()
-        self.vlcMedia = self.vlcInstance.media_new_fd(self.vlcMediaFD)
+        self.vlcMedia = self.vlcNewMedia()
 
     def vlcStopOnEndEvent(self, event):
         self.sendVLCEvent.send(b"\x00")
-- 
